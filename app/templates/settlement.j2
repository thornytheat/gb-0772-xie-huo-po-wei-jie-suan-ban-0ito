<h2>逐单差价</h2><div class="tablebox"><table><thead><tr><th>到达 / 泊位</th><th>应收</th><th>实收</th><th>差价</th><th>回执</th><th>结论</th></tr></thead><tbody>{% for row in report.settlement.lines %}<tr><td>{{ local(row.arrival) }} · {{ row.berth }}</td><td>{{ yuan(row.due_cents) }}</td><td>{{ yuan(row.paid_cents) }}</td><td class="{{ 'difference' if row.difference_cents else '' }}">{{ yuan(row.difference_cents) }}</td><td>{% for r in row.receipts %}{{ r.fields.receipt }} · 第 {{ r.line }} 行{% if not loop.last %} / {% endif %}{% else %}—{% endfor %}</td><td>{{ label[row.code] }}</td></tr>{% else %}<tr><td colspan="6">没有可结算停靠。</td></tr>{% endfor %}</tbody></table></div>
<section class="panel exceptions"><h3>游离实收</h3>{% for row in report.settlement.orphans %}<p>回执 {{ row.fields.receipt }} · 第 {{ row.line }} 行 · {{ yuan(row.cents) }}</p>{% else %}<p>无游离回执。</p>{% endfor %}</section>{% if report.settlement.isolated %}{% set issues=report.settlement.isolated %}{% include 'issues.j2' %}{% endif %}
{% if ruling_book %}<section class="panel"><h3>改判补差对账</h3>
<form id="ruling-form"><label>争议组 <select name="dispute_key">{% for g in ruling_book.disputes %}<option value="{{ g.dispute_key }}">{{ g.berth }} · {{ local(g.start) }} → {{ local(g.end) }} · {{ label[g.code] }} · {{ g.minutes }} 分钟</option>{% endfor %}</select></label><label>车辆代号 <input name="vehicle" required></label><label>裁定班次 <input name="shift" required></label><button type="submit" {% if not ruling_book.disputes %}disabled{% endif %}>提交裁定</button></form>
<div class="tablebox"><table><thead><tr><th>裁定</th><th>争议</th><th>改判前应收</th><th>改判后应收</th><th>补差</th><th>阶梯口径影响（不补收）</th><th>级联放行</th></tr></thead><tbody>{% for row in ruling_book.reconciliation.rows %}<tr><td>{{ row.ruling.shift }} 班 · {{ row.ruling.vehicle[:8] }} · {{ row.ruling.decided_at[:10] }}</td><td>{{ row.ruling.berth }} · {{ local(row.ruling.start) }} → {{ local(row.ruling.end) }}</td><td>{{ yuan(row.before_cents) }}</td><td>{{ yuan(row.after_cents) }}</td><td class="difference">{{ yuan(row.supplement_cents) }}</td><td>{{ yuan(row.tier_effect_cents) }}</td><td>{% for r in row.released %}{{ r.berth }} {{ local(r.at) }}{% if not loop.last %}、{% endif %}{% else %}—{% endfor %}</td></tr>{% else %}<tr><td colspan="7">暂无生效裁定。</td></tr>{% endfor %}</tbody></table></div>
{% set t=ruling_book.reconciliation.totals %}<p>补差合计 <b>{{ yuan(t.supplement_cents) }}</b> · 口径影响合计 <b>{{ yuan(t.tier_effect_cents) }}</b> · 应收 {{ yuan(t.original_due_cents) }} → {{ yuan(t.repriced_due_cents) }} · 勾稽{{ '已平' if ruling_book.reconciliation.balanced else '不平' }}</p></section>{% endif %}
